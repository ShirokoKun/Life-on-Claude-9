{
  "name": "claude-nine",
  "private": true,
  "type": "module",
  "description": "Life on Claude Nine: a cinematic three.js film engine (Blender-baked light, PBR, lens) and the Studio that runs it.",
  "scripts": {
    "studio": "node studio/setup.mjs && node studio/server.mjs --open",
    "setup": "node studio/setup.mjs",
    "serve": "node tools/serve.mjs",
    "render": "node tools/render_mp4.mjs",
    "render:preview": "node tools/render_mp4.mjs --w 1280 --h 720",
    "render:soft": "node tools/render_mp4.mjs --soft --step 2"
  },
  "dependencies": {
    "playwright": "^1.48.0"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
