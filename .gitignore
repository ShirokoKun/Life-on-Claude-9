__pycache__/
*.pyc
*.blend1
node_modules/
viewer/intro-data*.js
renders/
node_modules

# Studio (per machine)
studio/.local/
engine/assets/_try/
engine/assets/lighting/*/lightmaps/*_full.exr
engine/assets/lighting/*/lightmaps/*_live.exr
# CC0 Poly Haven models: node tools/polyhaven.mjs <id> fetches them again
blender/assets/props/

# Ch 1 VO + sound package (134 MB, from the six Ch01_part*.zip): the guide, timeline and cue sheet are tracked,
# the audio is not. Re-create with: unzip each Ch01_part*.zip into audio/
audio/Ch01_VO_SoundPackage/03_SOUND_DESIGN/stems/
audio/Ch01_VO_SoundPackage/03_SOUND_DESIGN/buses/
audio/Ch01_VO_SoundPackage/03_SOUND_DESIGN/mixes/

# Bake intermediates (blender/lib/lightmap.py writes them next to each time-of-day's lightmaps; the engine loads only
# the merged lm_*.exr)
engine/scenes/*/lighting/*/lightmaps/*_full.exr
engine/scenes/*/lighting/*/lightmaps/*_live.exr
# Renders stay out of the repo: tools/render_mp4.mjs makes them again (the older tracked deliveries stay as they are)
deliver/*.mp4
deliver/*.srt
# (the probe tools in tools/_probe*.mjs are tracked: the notes use them)
.DS_Store
